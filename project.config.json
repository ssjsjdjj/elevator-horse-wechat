{
  "description": "电梯里禁止变成马：原生 Canvas 微信小游戏，免构建、无外部依赖。",
  "projectname": "elevator-horse",
  "appid": "touristappid",
  "compileType": "game",
  "miniprogramRoot": "./",
  "setting": {
    "urlCheck": true,
    "es6": true,
    "enhance": true,
    "minified": true,
    "uploadWithSourceMap": true,
    "compileHotReLoad": false
  },
  "packOptions": {
    "ignore": [
      { "type": "folder", "value": "tests" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": "验收记录.md" },
      { "type": "file", "value": "package.json" }
    ],
    "include": []
  },
  "editorSetting": { "tabIndent": "insertSpaces", "tabSize": 2 }
}
